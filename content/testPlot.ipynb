import numpy as np
import matplotlib.pyplot as plt

mc = np.genfromtxt("gamgam_mc.txt", unpack=True)
data = np.genfromtxt("gamgam_data.txt", unpack=True)

plt.hist(mc[2] / 1000, bins=30, range=(0, 200),
         alpha=0.6, label="Monte Carlo")
plt.hist(data[2] / 1000, bins=30, range=(0, 200),
         alpha=0.6, label="Data")

plt.xlabel("Photon transverse momentum (GeV/c)")
plt.ylabel("Number of events")
plt.legend()
plt.show()
